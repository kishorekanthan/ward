{
  "pageHeader": {
    "padding": "18px 20px 14px",
    "bleed": "calc(-1 * var(--ward-page-inset))",
    "rowAlign": "flex-start",
    "titleFont": "700 26px/1.2 Figtree, system-ui, sans-serif",
    "titleTracking": "-0.01em",
    "crumbFont": "500 12px/1 Figtree, system-ui, sans-serif",
    "crumbTracking": "normal",
    "crumbTransform": "none",
    "actionGap": "8px"
  },
  "tabs": {
    "cap": 7,
    "current": "background: var(--ward-color-sageTint)",
    "hover": "background: var(--ward-color-accentTint)"
  }
}
