{
  "topbar": {
    "padding": "12px 20px",
    "gap": "10px",
    "background": "var(--ward-color-surface)",
    "border": "var(--ward-border) solid var(--ward-color-line)",
    "overflow": "hidden"
  },
  "mark": { "width": "15px", "height": "15px", "background": "var(--ward-color-text)" },
  "navigation": { "gap": "var(--ward-space-4)", "marginLeft": "var(--ward-space-3)", "overflow": "auto", "color": "var(--ward-color-muted)", "font": "500 12px/1 Figtree, system-ui, sans-serif" },
  "active": { "background": "var(--ward-color-sageTint)", "radius": "6px", "text": "var(--ward-color-sageInk)" },
  "hover": "var(--ward-color-accentTint)",
  "pageInset": { "padding": "0 20px 22px", "inset": "20px" }
}
