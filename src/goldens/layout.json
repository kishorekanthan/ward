{
  "subjectRail": {
    "dryrun": "var(--ward-width-dryrun)",
    "preview": "var(--ward-width-preview)",
    "border": "var(--ward-border) solid var(--ward-color-line)"
  },
  "drawer": {
    "width": "var(--ward-width-drawer)",
    "border": "var(--ward-border) solid var(--ward-color-line)",
    "shadow": "var(--ward-shadow-overlay)"
  },
  "board": {
    "colFloor": "240px",
    "laneFloor": "176px",
    "tracks": "minmax(clamp(var(--ward-width-stageColumn), (100% - (var(--ward-board-lanes, 1) - 1) * var(--ward-gap-lane)) / var(--ward-board-lanes, 1), var(--ward-width-colFloor)), 1fr)",
    "overflowX": "auto",
    "columnMinWidth": "var(--ward-width-stageColumn)"
  }
}
