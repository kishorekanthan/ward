{
  "name": "@trellis/ward",
  "version": "0.2.0",
  "description": "Shared React component library for Trellis — tokens, primitives, composites, patterns.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "tokens.json"
  ],
  "scripts": {
    "gen": "node scripts/gen-css.mjs",
    "check": "node scripts/check.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "probe:strut": "node scripts/strut.mjs",
    "build": "vite build",
    "test": "vitest run",
    "test:consumer": "node scripts/consumer-check.mjs",
    "lint": "eslint . && stylelint \"src/**/*.module.css\"",
    "changeset": "changeset",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^8.6.18",
    "stylelint": "^17.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "volta": {
    "node": "24.18.0",
    "npm": "11.16.0"
  }
}
